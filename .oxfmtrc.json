{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "trailingComma": "es5",
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "apps/builder/app/builder/features/cms-panel/native/rich-text-nodes.ts",
    "apps/builder/app/builder/features/cms-panel/native/rich-text-sanitize.ts",
    "pnpm-lock.yaml",
    "packages/prisma-client/prisma/migrations/*/client",
    "packages/prisma-client/**/*.d.ts",
    "**/*.yml",
    "**/*.yaml",
    "**/*.toml",
    "**/*.jsonc",
    "docs/**",
    "packages/cli/templates/**",
    "fixtures/**/__generated__/**",
    "packages/sdk-components-organizeos/src/field/__fixtures__/convergence-field.fixture.json"
  ]
}
