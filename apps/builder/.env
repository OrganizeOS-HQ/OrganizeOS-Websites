# To override environment variables, add a .env.development file in the same directory.
# For more details, visit: https://vitejs.dev/guide/env-and-mode#env-files
DATABASE_URL=postgresql://supabase_admin:pass@localhost:55432/webstudio?pgbouncer=true
DIRECT_URL=postgresql://supabase_admin:pass@localhost:55432/webstudio
PGPORT=55432
POSTGRES_DB=webstudio
POSTGRES_USER=supabase_admin
POSTGRES_PASSWORD=pass

AUTH_SECRET=0000
PORT=5176

# GH_CLIENT_SECRET=
# GH_CLIENT_ID=
DEV_LOGIN=true

POSTGREST_URL=http://localhost:55433
POSTGREST_PORT=55433
# Empty for the local PostgREST container.
POSTGREST_API_KEY=

# Optional max upload size in Mb
# MAX_UPLOAD_SIZE=10

# S3 envs
# S3_BUCKET=
# S3_REGION=
# S3_ACL="public-read"
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Asset CDN origin used by published builds, without a trailing slash.

# Publisher config
# PUBLISHER_HOST=wstd.io
# PUBLISHER_ENDPOINT=https://publisher.webstudio.is
# PUBLISHER_TOKEN=

# Username and password displayed in wstd domain settings
# STAGING_USERNAME=admin
# STAGING_PASSWORD=webstudio

# Base origin for accessing user-generated build (canvas / preview / etc)
# Should contain protocol and host (e.g. https://example.com)
# Will be detected automatically in development environments like localhost or preview deployment
# BUILD_ORIGIN=https://wstd.live

# If set to `true`, user-generated build will be available
# only at {project.domain} subdomain of {BUILD_ORIGIN}.
# This is used in production deployment for security reasons.
# BUILD_REQUIRE_SUBDOMAIN=

# Enable features behind a flag, * enables all.
FEATURE_FLAGS=*
# Plan definitions. JSON array of {name, extends?, features} objects.
# extends: inherit all features from a named parent plan, then override.
# Multiple active plans are merged (booleans: OR, numbers: max).
# Schema: packages/trpc-interface/src/shared/plan-features.ts
PLANS='[
  {
    "name": "Pro",
    "features": {
      "canDownloadAssets": true,
      "canRestoreBackups": true,
      "allowAdditionalPermissions": true,
      "allowDynamicData": true,
      "allowAuth": true,
      "allowContentMode": true,
      "allowStagingPublish": true,
      "maxContactEmailsPerProject": 5,
      "maxDomainsAllowedPerUser": 200,
      "maxDailyPublishesPerUser": 100,
      "maxProjectsAllowedPerUser": 300,
      "maxAssetsPerProject": 350
    }
  },
  {
    "name": "Team",
    "extends": "Pro",
    "features": {
      "maxWorkspaces": 20,
      "seatsIncluded": 4,
      "maxSeatsPerWorkspace": 20
    }
  }  
]'


# TRCP server url and API token. If empty local TRPC server is used
# TRPC_SERVER_URL=
# TRPC_SERVER_API_TOKEN=

# OrganizeOS integration (see docs/ORGANIZEOS-FORK.md).
# The OrganizeOS app the builder hands users back to; defaults to production.
# ORGANIZEOS_APP_URL=https://app.organizeos.org
# The platform base domain: an org's site is served at <subdomain>.<PUBLISHER_HOST>.
# PUBLISHER_HOST=organizeos.org
# Shared secret for the internal provisioning route (server-to-server only).
# ORGANIZEOS_PROVISION_TOKEN=
# Public key (PEM) verifying OrganizeOS SSO tokens.
# ORGANIZEOS_SSO_PUBLIC_KEY=
# Session binding (docs/ORGANIZEOS-FORK.md §5): observe (default) logs an SSO session whose
# OrganizeOS session ended and allows it; enforce signs it out.
# ORGANIZEOS_SESSION_BINDING=observe
# Expire the platform's old domain-wide session cookie on builder documents (docs/ORGANIZEOS-FORK.md §5).
# true only after the app host's host-only session is verified in production; off before rolling it back.
# ORGANIZEOS_EXPIRE_LEGACY_SESSION=false
# Publish executor dispatch: repo carrying publish-site.yml + a token with actions:write.
# ORGANIZEOS_PUBLISH_REPO=OrganizeOS-HQ/OrganizeOS-Websites
# ORGANIZEOS_PUBLISH_GITHUB_TOKEN=
# The OrganizeOS blocks and panels are offered to every org except these: comma-separated organization ids. Empty denies none.
# ORGANIZEOS_BLOCKS_DENY_ORG_IDS=
# The CMS rail button, which opens the CMS overlay, shows only when this is true.
# ORGANIZEOS_CMS_PANEL=
# The Shop blocks (Product Grid, Product Card) are listed, and the Products catalog Resource seeded, only when this is true.
# ORGANIZEOS_SHOP_BLOCKS=
# Each catalog Resource gets one :root binding (bindable from every element) only when this is true, for every org the deny list above allows. Unset removes the unreferenced ones.
# ORGANIZEOS_CATALOG_ROOT_BINDINGS=
# Shared HMAC key for draft preview on the canvas; the same value as OrganizeOS's. Unset means no preview header.
# WEBSITES2_PREVIEW_SECRET=
# Shared HMAC key for the CMS door (X-OOS-Actor); the same value as OrganizeOS's. Unset turns the native CMS screen off.
# WEBSITES2_CMS_SECRET=
# The native CMS screen replaces the framed CMS only when this is true (with ORGANIZEOS_CMS_PANEL=true and WEBSITES2_CMS_SECRET), for the orgs listed below.
# ORGANIZEOS_CMS_NATIVE=
# Comma-separated organization ids that get the native CMS screen while ORGANIZEOS_CMS_NATIVE is true. Empty gives it to none.
# ORGANIZEOS_CMS_NATIVE_ORG_IDS=
