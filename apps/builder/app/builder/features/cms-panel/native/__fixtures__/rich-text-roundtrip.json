{
  "format": "OrganizeOS rich-text round trip, version 1",
  "about": "Each case is a stored rich-text value (input), the HTML the builder's native CMS editor writes after loading it (editor, pinned by the fork's test), and that HTML after the platform's normalizeRichText (stored, pinned by this repository's test; null when nothing is left). readOnly holds stored values the editor must open read-only, with the reason: images, or lossy for a shape it would not keep whole. The builder fork copies this file unchanged. Spec: docs/superpowers/specs/2026-11-07-native-cms-in-the-builder-design.md, 4.3.3.1 and 8.",
  "cases": [
    {
      "name": "paragraphs",
      "input": "<p>One</p><p>Two</p>",
      "editor": "<p><span style=\"white-space: pre-wrap;\">One</span></p><p><span style=\"white-space: pre-wrap;\">Two</span></p>"
    },
    {
      "name": "headings 2 to 4",
      "input": "<h2>A</h2><h3>B</h3><h4>C</h4><p>Body</p>",
      "editor": "<h2><span style=\"white-space: pre-wrap;\">A</span></h2><h3><span style=\"white-space: pre-wrap;\">B</span></h3><h4><span style=\"white-space: pre-wrap;\">C</span></h4><p><span style=\"white-space: pre-wrap;\">Body</span></p>"
    },
    {
      "name": "every mark",
      "input": "<p><strong>bold</strong> <em>italic</em> <u>underline</u> <s>struck</s> <code>code</code></p>",
      "editor": "<p><b><strong style=\"white-space: pre-wrap;\">bold</strong></b><span style=\"white-space: pre-wrap;\"> </span><i><em style=\"white-space: pre-wrap;\">italic</em></i><span style=\"white-space: pre-wrap;\"> </span><u><span style=\"white-space: pre-wrap;\">underline</span></u><span style=\"white-space: pre-wrap;\"> </span><s><span style=\"white-space: pre-wrap;\">struck</span></s><span style=\"white-space: pre-wrap;\"> </span><code spellcheck=\"false\" style=\"white-space: pre-wrap;\"><span>code</span></code></p>"
    },
    {
      "name": "b, i and nested marks",
      "input": "<p><b>b</b> <i>i</i> <strong><em>both</em></strong></p>",
      "editor": "<p><b><strong style=\"white-space: pre-wrap;\">b</strong></b><span style=\"white-space: pre-wrap;\"> </span><i><em style=\"white-space: pre-wrap;\">i</em></i><span style=\"white-space: pre-wrap;\"> </span><i><b><strong style=\"white-space: pre-wrap;\">both</strong></b></i></p>"
    },
    {
      "name": "link, new tab",
      "input": "<p>Ask your <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://example.org/stewards\">steward</a>.</p>",
      "editor": "<p><span style=\"white-space: pre-wrap;\">Ask your </span><a href=\"https://example.org/stewards\" target=\"_blank\" rel=\"noopener noreferrer\"><span style=\"white-space: pre-wrap;\">steward</span></a><span style=\"white-space: pre-wrap;\">.</span></p>"
    },
    {
      "name": "link, same tab, title",
      "input": "<p><a href=\"https://example.org/\" title=\"Home\">Home</a></p>",
      "editor": "<p><a href=\"https://example.org/\" title=\"Home\"><span style=\"white-space: pre-wrap;\">Home</span></a></p>"
    },
    {
      "name": "link schemes and paths",
      "input": "<p><a href=\"mailto:info@example.org\">Mail</a> <a href=\"tel:+15550100\">Call</a> <a href=\"/about\">About</a> <a href=\"#join\">Join</a></p>",
      "editor": "<p><a href=\"mailto:info@example.org\"><span style=\"white-space: pre-wrap;\">Mail</span></a><span style=\"white-space: pre-wrap;\"> </span><a href=\"tel:+15550100\"><span style=\"white-space: pre-wrap;\">Call</span></a><span style=\"white-space: pre-wrap;\"> </span><a href=\"/about\"><span style=\"white-space: pre-wrap;\">About</span></a><span style=\"white-space: pre-wrap;\"> </span><a href=\"#join\"><span style=\"white-space: pre-wrap;\">Join</span></a></p>"
